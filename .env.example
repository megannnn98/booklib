# ---- booklib environment template ----
# Скопировать в `.env` и поправить под себя. `.env` в репозиторий не коммитится.

# Корень библиотеки. Читается строго read-only.
BOOKLIB_ROOT=/run/media/b/DOWNLOADS/books

# Изменяемое состояние: СУБД и кэш обложек.
BOOKLIB_CACHE_DIR=/home/b/.cache/booklib

# Каталог с taxonomy.json и rules.json.
# BOOKLIB_CONFIG_DIR=config

# HTTP. НЕ менять host на 0.0.0.0: /api/open запускает процессы в вашей сессии.
BOOKLIB_HOST=127.0.0.1
BOOKLIB_PORT=8765
BOOKLIB_SCAN_ON_START=true

# Превью
# BOOKLIB_COVER_WIDTH=400
# BOOKLIB_COVER_WORKERS=4
