# Android build outputs
.gradle/
**/build/
local.properties

# Kotlin daemon logs
.kotlin/

# Signing keys and keystores
*.jks
*.keystore
**/*.jks
**/*.keystore

# APK/AAB outputs (built artifacts)
**/*.apk
**/*.aab

# Private keys (must never be committed)
ca-key.pem
server-key.pem
*.p12
*.pfx

# IDE
.idea/
*.iml
.DS_Store

# Gradle wrapper jar is tracked, but not the distribution
# (gradle-wrapper.jar is needed for reproducible builds)
